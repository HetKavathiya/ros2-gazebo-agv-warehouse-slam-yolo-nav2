<?xml version="1.0" ?>
<robot name="agv_chassis" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<gazebo reference="base_link">
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <gravity>true</gravity>
</gazebo>

<!-- INCREASED FRICTION FOR WHEELS -->
<gazebo reference="wheel_fr_1">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="wheel_rr_1">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="wheel_fl_1">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="wheel_rl_1">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

  <!-- ================= LIDAR SENSOR ================= -->
<gazebo reference="prlidar_1">
  <sensor name="lidar" type="gpu_lidar">
    <pose>0 0 0.09 0 0 0</pose>
    <topic>scan</topic>
    <gz_frame_id>prlidar_1</gz_frame_id>
    <update_rate>10</update_rate>
    <always_on>true</always_on>
    <visualize>true</visualize>
    <lidar>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.1</min>
        <max>20.0</max>
        <resolution>0.01</resolution>
      </range>
      <!-- SDF 1.9: Add noise for realism -->
      <noise type="gaussian">
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>
    </lidar>
  </sensor>
</gazebo>

  <!-- ================= DEPTH CAMERA SENSOR ================= -->
<gazebo reference="deepth_camera_1">
  <sensor name="camera" type="rgbd_camera">
    <pose>0 0 0 0 0 0</pose>
    <topic>camera</topic>
    <gz_frame_id>deepth_camera_1</gz_frame_id>
    <update_rate>30</update_rate>
    <always_on>true</always_on>
    <visualize>true</visualize>
    <camera>
      <horizontal_fov>1.047</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.05</near>
        <far>20.0</far>
      </clip>
      <!-- SDF 1.9: Add noise for realism -->
      <noise type="gaussian">
        <mean>0.0</mean>
        <stddev>0.007</stddev>
      </noise>
    </camera>
  </sensor>
</gazebo>

  <!-- ================= IMU SENSOR ================= -->
<gazebo reference="imu_1">
  <sensor name="imu" type="imu">
    <pose>0 0 0 0 0 0</pose>
    <topic>imu</topic>
    <gz_frame_id>imu_1</gz_frame_id>
    <update_rate>100</update_rate>
    <always_on>true</always_on>
    <imu>
      <!-- SDF 1.9: Add noise parameters for all axes -->
      <angular_velocity>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
      </angular_velocity>
      <linear_acceleration>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
      </linear_acceleration>
    </imu>
  </sensor>
</gazebo>

  <!-- ================= SENSOR & IMU SYSTEM PLUGINS ================= -->
<gazebo>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>
  <!-- CRITICAL: Required for IMU data to be published -->
  <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
  </plugin>
</gazebo>

<!-- CRITICAL: publishes wheel joint angles so robot_state_publisher can make the wheel TFs -->
<gazebo>
  <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    <topic>joint_states</topic>
  </plugin>
</gazebo>

<gazebo>
  <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
    <left_joint>Revolute_20</left_joint>
    <left_joint>Revolute_21</left_joint>
    <right_joint>Revolute_18</right_joint>
    <right_joint>Revolute_19</right_joint>
    <wheel_separation>0.56</wheel_separation>
    <wheel_radius>0.13</wheel_radius>
    <max_wheel_torque>20</max_wheel_torque>
    <max_linear_acceleration>1.0</max_linear_acceleration>
    <topic>cmd_vel</topic>
    <odom_topic>odom</odom_topic>
    <frame_id>odom</frame_id>
    <child_frame_id>base_link</child_frame_id>
    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>
    <tf_topic>/tf</tf_topic>
  </plugin>  
</gazebo>
</robot>