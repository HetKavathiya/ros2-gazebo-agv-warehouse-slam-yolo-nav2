<joint name="Revolute_18" type="continuous">
  <origin xyz="0.25 -0.28 0.13" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="wheel_fr_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="Revolute_19" type="continuous">
  <origin xyz="-0.25 -0.28 0.13" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="wheel_rr_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="Revolute_20" type="continuous">
  <origin xyz="0.25 0.28 0.13" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="wheel_fl_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="Revolute_21" type="continuous">
  <origin xyz="-0.25 0.28 0.13" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="wheel_rl_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="Rigid_22" type="fixed">
  <origin xyz="0.37 0.0 0.25" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="prlidar_1"/>
</joint>

<joint name="Rigid_23" type="fixed">
  <origin xyz="0.45 0.0 0.25" rpy="0 0 0"/>
  <parent link="base_link"/>
