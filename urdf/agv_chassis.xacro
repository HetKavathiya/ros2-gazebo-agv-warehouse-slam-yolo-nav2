<?xml version="1.0" ?>
<robot name="agv_chassis" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find agv_chassis_description)/urdf/materials.xacro" />
<xacro:include filename="$(find agv_chassis_description)/urdf/agv_chassis.ros2control" />
<xacro:include filename="$(find agv_chassis_description)/urdf/agv_chassis.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.04095946691628852 -7.671025616022228e-17 0.13940960726455276" rpy="0 0 0"/>
    <mass value="476.5257331080669"/>
    <inertia ixx="15.002666" iyy="35.853916" izz="49.429123" ixy="0.0" iyz="-0.0" ixz="-1.475391"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find agv_chassis_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="chassis_blue"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find agv_chassis_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

