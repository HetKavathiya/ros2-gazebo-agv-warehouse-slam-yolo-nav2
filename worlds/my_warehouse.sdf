<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="warehouse">

    <!-- Physics Engine -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Sun and Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Scene Settings -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Walls (20x20 meter room) -->
    <model name="walls">
      <static>true</static>
      <!-- Wall 1 (North) -->
      <link name="wall_north">
        <pose>0 10 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>20 0.5 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20 0.5 2</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
      <!-- Wall 2 (South) -->
      <link name="wall_south">
        <pose>0 -10 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>20 0.5 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20 0.5 2</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
      <!-- Wall 3 (East) -->
      <link name="wall_east">
        <pose>10 0 1 0 0 1.5707</pose>
        <collision name="collision"><geometry><box><size>20 0.5 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20 0.5 2</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
      <!-- Wall 4 (West) -->
      <link name="wall_west">
        <pose>-10 0 1 0 0 1.5707</pose>
        <collision name="collision"><geometry><box><size>20 0.5 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20 0.5 2</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Warehouse Shelves (Blue) -->
    <model name="shelves">
      <static>true</static>
      <link name="shelf_1">
        <pose>5 5 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3 1 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3 1 2</size></box></geometry>
          <material><ambient>0.1 0.2 0.6 1</ambient><diffuse>0.1 0.2 0.6 1</diffuse></material>
        </visual>
      </link>
      <link name="shelf_2">
        <pose>5 -5 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3 1 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3 1 2</size></box></geometry>
          <material><ambient>0.1 0.2 0.6 1</ambient><diffuse>0.1 0.2 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Cardboard Boxes (Brown) -->
    <model name="boxes">
      <static>true</static>
      <link name="box_1">
        <pose>-3 3 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="box_2">
        <pose>-3 3 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Safety Cones (Orange/Yellow) - Good targets for YOLO -->
    <model name="safety_cones">
      <static>true</static>
      <link name="cone_1">
        <pose>2 -2 0.5 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
      <link name="cone_2">
        <pose>-2 -4 0.5 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>